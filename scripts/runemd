#!/bin/sh
# Command-line shim: `runemd file.md [more.md]` opens the files in RuneMD.
# Relative paths made absolute, because `open` works from its own folder.
for f in "$@"; do
  case "$f" in /*) set -- "$@" "$f" ;; *) set -- "$@" "$PWD/$f" ;; esac
  shift
done
exec open -a /Applications/RuneMD.app "$@"
